NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2026-09-16（複数プロバイダー対応）：Google/Appleログインのボタン表示を制御する機能フラグ。
# Supabase・Google Cloud・Apple Developer側の本番設定が完了するまでは
# 空欄のまま（未設定=無効）にしておくこと。有効化する際は "true" を設定する。
# Client Secret等の秘密情報はここには置かない（Supabase Auth側の設定にのみ保存する）。
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=
NEXT_PUBLIC_ENABLE_APPLE_LOGIN=
